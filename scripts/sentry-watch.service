[Unit]
Description=Sentry autofix watcher (dispatch vers whatsapp-agent)
After=network-online.target whatsapp-agent.service
Wants=network-online.target
Requires=whatsapp-agent.service

[Service]
Type=oneshot
User=wa-agent
EnvironmentFile=/etc/whatsapp-agent.env
StateDirectory=sentry-watch
ExecStart=/usr/bin/node /opt/whatsapp-agent/app/scripts/sentry-watch.js
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sentry-watch

# Limites
TimeoutStartSec=300
MemoryMax=256M
TasksMax=32

# Hardening (aligné sur les autres watchers : pas de root, système en lecture seule)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
